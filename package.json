{
  "name": "@eduwork/dsh-side-chat",
  "version": "0.1.2",
  "description": "Ask side questions without derailing the main thread; forks a branch and archives it when closed.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MulanPSL-2.0 AND MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "MARKET.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.22.1",
    "dsh": ">=0.2.1 <0.3.0"
  },
  "keywords": [
    "side-chat",
    "fork",
    "session"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2 || 4.1.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.3 <0.3.0-0 || >=0.2.2-rc.1 <0.2.3-0",
    "react": "^18.2.0"
  }
}
